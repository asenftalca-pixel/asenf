
{
  "entities": {
    "Partner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Partner",
      "type": "object",
      "description": "Represents a partner application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Partner entity."
        },
        "appName": {
          "type": "string",
          "description": "Name of the partner application."
        },
        "description": {
          "type": "string",
          "description": "Description of the partner application."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL of the partner application's logo."
        },
        "websiteUrl": {
          "type": "string",
          "description": "URL of the partner application's website."
        }
      },
      "required": [
        "id",
        "appName",
        "description",
        "logoUrl",
        "websiteUrl"
      ]
    },
    "Associate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Associate",
      "type": "object",
      "description": "Represents an associate linked to a partner application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Associate entity."
        },
        "partnerId": {
          "type": "string",
          "description": "Reference to Partner."
        },
        "name": {
          "type": "string",
          "description": "Name of the associate."
        },
        "email": {
          "type": "string",
          "description": "Email address of the associate.",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the associate."
        },
        "role": {
          "type": "string",
          "description": "Role of the associate within the partner application."
        }
      },
      "required": [
        "id",
        "partnerId",
        "name",
        "email",
        "phoneNumber",
        "role"
      ]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "marca": { "type": "string" },
        "peso": { "type": "string" },
        "precio": { "type": "number" }
      }
    },
    "GasOrder": {
      "title": "GasOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "socioNombre": { "type": "string" },
        "productoNombre": { "type": "string" },
        "marca": { "type": "string" },
        "peso": { "type": "string" },
        "cantidad": { "type": "number" },
        "fecha": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/partners/{partnerId}",
        "definition": {
          "entityName": "Partner",
          "schema": {
            "$ref": "#/backend/entities/Partner"
          },
          "description": "Stores partner application data."
        }
      },
      {
        "path": "/partners/{partnerId}/associates/{associateId}",
        "definition": {
          "entityName": "Associate",
          "schema": {
            "$ref": "#/backend/entities/Associate"
          },
          "description": "Stores associate data."
        }
      },
      {
        "path": "/productos/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Catálogo de vales de gas disponibles."
        }
      },
      {
        "path": "/pedidos_socios/{orderId}",
        "definition": {
          "entityName": "GasOrder",
          "schema": { "$ref": "#/backend/entities/GasOrder" },
          "description": "Registro de pedidos de vales de gas realizados por los socios."
        }
      }
    ]
  }
}
