
{
  "entities": {
    "Partner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Partner",
      "type": "object",
      "description": "Represents a partner application.",
      "properties": {
        "id": { "type": "string" },
        "appName": { "type": "string" },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "websiteUrl": { "type": "string" }
      },
      "required": ["id", "appName", "description", "logoUrl", "websiteUrl"]
    },
    "Associate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Associate",
      "type": "object",
      "description": "Represents an associate linked to a partner application.",
      "properties": {
        "id": { "type": "string" },
        "partnerId": { "type": "string" },
        "nombre": { "type": "string" },
        "rut": { "type": "string" },
        "sexo": { "type": "string" },
        "telefono": { "type": "string" },
        "email": { "type": "string" },
        "servicio": { "type": "string" },
        "establecimiento": { "type": "string" },
        "firmaUrl": { "type": "string" },
        "fecha": { "type": "string" },
        "processed": { "type": "boolean" }
      },
      "required": ["id", "partnerId", "nombre", "rut", "firmaUrl"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Elemento del catálogo de vales de gas.",
      "properties": {
        "id": { "type": "string" },
        "Nombre": { "type": "string" },
        "Marca": { "type": "string" },
        "Kilos": { "type": "string" },
        "Precio": { "type": "number" }
      },
      "required": ["Nombre", "Marca", "Kilos", "Precio"]
    },
    "GasOrder": {
      "title": "GasOrder",
      "type": "object",
      "description": "Registro de pedidos de vales de gas realizados por los socios.",
      "properties": {
        "id": { "type": "string" },
        "socioNombre": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "marca": { "type": "string" },
              "peso": { "type": "string" },
              "cantidad": { "type": "number" },
              "precioUnitario": { "type": "number" },
              "total": { "type": "number" }
            }
          }
        },
        "totalGeneral": { "type": "number" },
        "comprobanteUrl": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pendent", "checked", "delivered"] },
        "detalleResumen": { "type": "string" }
      },
      "required": ["socioNombre", "items", "totalGeneral", "comprobanteUrl", "fecha"]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "prioridad": { "type": "string" },
        "completada": { "type": "boolean" },
        "fecha": { "type": "string" }
      }
    },
    "Nomina": {
      "title": "Nomina",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "rut": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "BudgetGoal": {
      "title": "BudgetGoal",
      "type": "object",
      "description": "Metas de presupuesto anual por categoría.",
      "properties": {
        "categoria": { "type": "string" },
        "presupuesto": { "type": "number" },
        "year": { "type": "number" },
        "tipo": { "type": "string", "enum": ["ingreso", "egreso"] }
      }
    },
    "PartyRegistration": {
      "title": "PartyRegistration",
      "type": "object",
      "description": "Registro de inscripción para la fiesta del día de la enfermera.",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "servicio": { "type": "string" },
        "email": { "type": "string" },
        "telefono": { "type": "string" },
        "tipoSocio": { "type": "string", "enum": ["ASENF", "COLENF", "ASENF y COLENF", "Ninguno"] },
        "eleccionPlato": { "type": "string", "enum": ["Vegetariano", "Sin restricciones de alimentación", "otra restricción"] },
        "monto": { "type": "number" },
        "comprobanteUrl": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/partners/{partnerId}",
        "definition": {
          "entityName": "Partner",
          "schema": { "$ref": "#/backend/entities/Partner" },
          "description": "Stores partner application data."
        }
      },
      {
        "path": "/partners/{partnerId}/associates/{associateId}",
        "definition": {
          "entityName": "Associate",
          "schema": { "$ref": "#/backend/entities/Associate" },
          "description": "Stores associate data."
        }
      },
      {
        "path": "/productos/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Catálogo de vales de gas disponibles."
        }
      },
      {
        "path": "/pedidos_socios/{orderId}",
        "definition": {
          "entityName": "GasOrder",
          "schema": { "$ref": "#/backend/entities/GasOrder" },
          "description": "Registro de pedidos de vales de gas realizados por los socios."
        }
      },
      {
        "path": "/tareas/{taskId}",
        "definition": {
          "entityName": "Task",
          "schema": { "$ref": "#/backend/entities/Task" },
          "description": "Tareas internas de la directiva."
        }
      },
      {
        "path": "/nomina_maestra/{nominaId}",
        "definition": {
          "entityName": "Nomina",
          "schema": { "$ref": "#/backend/entities/Nomina" },
          "description": "Nomina maestra de socios activos."
        }
      },
      {
        "path": "/presupuesto_anual_asenf/{goalId}",
        "definition": {
          "entityName": "BudgetGoal",
          "schema": { "$ref": "#/backend/entities/BudgetGoal" },
          "description": "Metas de presupuesto para el control de gestión."
        }
      },
      {
        "path": "/fiesta_enfermeria/{registrationId}",
        "definition": {
          "entityName": "PartyRegistration",
          "schema": { "$ref": "#/backend/entities/PartyRegistration" },
          "description": "Registro de inscritos para la fiesta anual."
        }
      }
    ]
  }
}
