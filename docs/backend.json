
{
  "entities": {
    "Partner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Partner",
      "type": "object",
      "description": "Represents a partner application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Partner entity."
        },
        "appName": {
          "type": "string",
          "description": "Name of the partner application."
        },
        "description": {
          "type": "string",
          "description": "Description of the partner application."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL of the partner application's logo."
        },
        "websiteUrl": {
          "type": "string",
          "description": "URL of the partner application's website."
        }
      },
      "required": [
        "id",
        "appName",
        "description",
        "logoUrl",
        "websiteUrl"
      ]
    },
    "Associate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Associate",
      "type": "object",
      "description": "Represents an associate linked to a partner application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Associate entity."
        },
        "partnerId": {
          "type": "string",
          "description": "Reference to Partner."
        },
        "nombre": {
          "type": "string",
          "description": "Nombre completo del socio."
        },
        "rut": {
          "type": "string",
          "description": "RUT del socio."
        },
        "sexo": {
          "type": "string",
          "description": "Sexo del socio."
        },
        "servicio": {
          "type": "string",
          "description": "Servicio o unidad donde se desempeña."
        },
        "establecimiento": {
          "type": "string",
          "description": "Establecimiento de salud."
        },
        "firmaUrl": {
          "type": "string",
          "description": "URL o base64 de la firma del socio."
        },
        "fecha": {
          "type": "string",
          "description": "Fecha de registro."
        },
        "processed": {
          "type": "boolean",
          "description": "Indica si la solicitud fue tramitada por la directiva."
        }
      },
      "required": [
        "id",
        "partnerId",
        "nombre",
        "rut",
        "firmaUrl"
      ]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Elemento del catálogo de vales de gas.",
      "properties": {
        "id": { "type": "string" },
        "Nombre": { "type": "string" },
        "Marca": { "type": "string" },
        "Kilos": { "type": "string" },
        "Precio": { "type": "number" }
      },
      "required": ["Nombre", "Marca", "Kilos", "Precio"]
    },
    "GasOrder": {
      "title": "GasOrder",
      "type": "object",
      "description": "Registro de pedidos de vales de gas realizados por los socios.",
      "properties": {
        "id": { "type": "string" },
        "socioNombre": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "marca": { "type": "string" },
              "peso": { "type": "string" },
              "cantidad": { "type": "number" },
              "precioUnitario": { "type": "number" },
              "total": { "type": "number" }
            }
          }
        },
        "totalGeneral": { "type": "number" },
        "comprobanteUrl": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pendent", "processed"] },
        "detalleResumen": { "type": "string" }
      },
      "required": ["socioNombre", "items", "totalGeneral", "comprobanteUrl", "fecha"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/partners/{partnerId}",
        "definition": {
          "entityName": "Partner",
          "schema": {
            "$ref": "#/backend/entities/Partner"
          },
          "description": "Stores partner application data."
        }
      },
      {
        "path": "/partners/{partnerId}/associates/{associateId}",
        "definition": {
          "entityName": "Associate",
          "schema": {
            "$ref": "#/backend/entities/Associate"
          },
          "description": "Stores associate data."
        }
      },
      {
        "path": "/productos/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Catálogo de vales de gas disponibles."
        }
      },
      {
        "path": "/pedidos_socios/{orderId}",
        "definition": {
          "entityName": "GasOrder",
          "schema": { "$ref": "#/backend/entities/GasOrder" },
          "description": "Registro de pedidos de vales de gas realizados por los socios."
        }
      }
    ]
  }
}
