rules_version = '2';

/**
 * FIRESTORE SECURITY RULES - PROTOTYPING MODE
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the Partner entity.
     */
    match /partners/{partnerId} {
      // Allow public read of partner profiles for the association
      allow get: if true;
      // Allow list and write operations if signed in (Admin access for prototype)
      allow list, create, update, delete: if isSignedIn();

      /**
       * @description Rules for Associates nested under a Partner.
       */
      match /associates/{associateId} {
        // Allow anyone to submit a join request (public create)
        allow create: if true;
        // Allow get, list, update, and delete for authenticated admins
        allow get, list, update, delete: if isSignedIn();
      }
    }
  }
}