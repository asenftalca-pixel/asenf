
rules_version = '2';

/**
 * FIRESTORE SECURITY RULES - PUBLIC MODE
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the Partner entity.
     */
    match /partners/{partnerId} {
      // Allow public read of partner profiles
      allow get, list: if true;
      // Allow write operations if signed in
      allow create, update, delete: if isSignedIn();

      /**
       * @description Rules for Associates nested under a Partner.
       */
      match /associates/{associateId} {
        // Allow anyone to submit a join request and see the list of associates
        allow create, list, get: if true;
        // Allow update and delete only for authenticated admins (or everyone for prototype if desired)
        allow update, delete: if true;
      }
    }
  }
}
