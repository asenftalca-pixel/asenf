
rules_version = '2';

/**
 * FIRESTORE SECURITY RULES - PUBLIC MODE
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the Partner entity and nested associates.
     */
    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update, delete: if true;

      match /associates/{associateId} {
        allow create, list, get: if true;
        allow update, delete: if true;
      }
    }

    /**
     * @description Rules for the Products (Gas Vouchers) catalog.
     */
    match /productos/{productId} {
      allow get, list: if true;
      allow write: if true;
    }

    /**
     * @description Rules for Gas Orders submitted by socios.
     */
    match /pedidos_socios/{orderId} {
      allow create: if true;
      allow get, list, update, delete: if true;
    }

    /**
     * @description Rules for internal finance records.
     */
    match /finanzas_asenftalca/{docId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for application settings (finances, gas costs).
     */
    match /settings/{docId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for tasks and commitments.
     */
    match /tareas/{taskId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for the master member list.
     */
    match /nomina_maestra/{nominaId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for annual budget goals.
     */
    match /presupuesto_anual_asenf/{goalId} {
      allow read, write: if true;
    }
  }
}
