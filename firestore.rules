
rules_version = '2';

/**
 * FIRESTORE SECURITY RULES - PUBLIC MODE
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the Partner entity and nested associates.
     */
    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();

      match /associates/{associateId} {
        allow create, list, get: if true;
        allow update, delete: if true;
      }
    }

    /**
     * @description Rules for the Products (Gas Vouchers) catalog.
     */
    match /productos/{productId} {
      // Catalog is publicly readable
      allow get, list: if true;
      // Writing to catalog requires authentication (admin)
      allow write: if isSignedIn();
    }

    /**
     * @description Rules for Gas Orders submitted by socios.
     */
    match /pedidos_socios/{orderId} {
      // Any user (even anonymous) can submit an order request
      allow create: if true;
      // Reading orders is allowed for management (authenticated)
      allow get, list, update, delete: if true;
    }
  }
}
